# MongoDB (same secret name used elsewhere in the constellation)
MONGODB_URI=
MONGODB_DB_NAME=ptah_realty

# AWS Bedrock (report narrative generation)
AWS_REGION=us-east-1

# Optional AWS-native object storage and map configuration
REALTY_S3_BUCKET=
REALTY_S3_PREFIX=realty
AWS_LOCATION_MAP_NAME=
AWS_LOCATION_API_KEY=

# Apify (Property24 comparable sales ingestion -- Property24 has no public API)
APIFY_TOKEN=
APIFY_PROPERTY24_ACTOR=crawlerbros/property24-scraper

# Local report storage
REALTY_REPORTS_DIR=./data/reports

# Local property-photo storage (served at /media)
REALTY_MEDIA_DIR=./data/media

PORT=8010
