.env
.env.local
.env.*.local
node_modules/
dist/
__pycache__/
*.pyc
# Anchored to repo root only -- an unanchored "data/" here previously
# matched ANY directory named "data" anywhere in the tree, which silently
# excluded the real source folder frontend/src/crm/data/ (mockData.ts)
# from every commit. That file never made it into git at all, so Vercel's
# build failed with "Could not resolve './data/mockData'" even though it
# existed locally and tsc/npm run build passed on this machine.
/data/
*.log
.vercel/

# This is the ptah-realty *frontend* repo. The FastAPI backend lives in
# the separate constellation/ptah-realty-backend repo (its own git
# history, its own AWS ECS deploy pipeline) -- a stray copy or zip of
# that source occasionally ends up here from local file shuffling and
# must never be committed to this repo.
_backend_src/
_backend_src.zip
