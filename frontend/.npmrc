include=dev
# react-simple-maps@3.0.0's peerDependencies still cap at React 18 even
# though it runs fine under React 19 -- npm's default (non-legacy) ERESOLVE
# strictness treats that stale peer-dep range as a hard conflict against
# the rest of this project's React 19 tree and fails `npm install`
# entirely. legacy-peer-deps=true tells npm to warn instead of erroring on
# stale/mismatched peer ranges, matching how npm 6 always behaved -- no
# actual package versions change, only dependency resolution strictness.
legacy-peer-deps=true
