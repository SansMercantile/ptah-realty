# Port the production Express server listens on
PORT=3010

# Where the PTAH Realty backend (FastAPI, deployed separately on AWS) is
# reachable from this server -- used to proxy /api and /media in production.
# Not needed for `npm run dev`, which uses vite.config.ts's server.proxy
# (localhost:8010) instead. Not needed on Vercel either -- vercel.json's
# rewrites handle this in production there.
REALTY_BACKEND_URL=https://ptahrealty-api.sansmercantile.com

# Google Maps Platform -- used by RealCadastreMap.tsx.
VITE_GOOGLE_MAPS_API_KEY=
# VITE_GOOGLE_MAPS_MAP_ID=   # optional, needed only for AdvancedMarker styling

# Carto Cloud Native v3 API access token -- a connection-scoped JWT for the
# Maps/SQL/Tilesets APIs. NOT the free "Basemaps API key" below -- this one
# alone does not clear the "API key required" watermark on basemap tiles.
VITE_CARTO_MAPS_API_KEY=
VITE_CARTO_MAPS_API_BASE_URL=
VITE_CARTO_MAPS_CLIENT_ID=

# Free Carto Basemaps API key (request at https://carto.com/basemaps/apikey).
# Clears the watermark on the Cadastral Dark / Deeds Plan Light basemap
# styles (Street GIS is the default and needs no key at all). Read by both
# RealCadastreMap.tsx and the CRM's LeadLeafletMap.tsx.
VITE_CARTO_BASEMAPS_API_KEY=
